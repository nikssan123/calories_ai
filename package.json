{
  "name": "calorytracker",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "pnpm --filter @ct/api migrate",
    "dev": "pnpm --parallel --filter @ct/api --filter @ct/web dev",
    "dev:api": "pnpm --filter @ct/api dev",
    "dev:web": "pnpm --filter @ct/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ct/api test",
    "test:coverage": "pnpm --filter @ct/api test:coverage",
    "build": "pnpm -r build",
    "seed": "pnpm --filter @ct/api seed",
    "db:reset": "bash scripts/db-reset.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}

{
  "name": "calorytracker",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "pnpm --filter @ct/api migrate",
    "dev": "pnpm --parallel --filter @ct/api --filter @ct/web dev",
    "dev:api": "pnpm --filter @ct/api dev",
    "dev:web": "pnpm --filter @ct/web dev",
    "dev:mobile": "pnpm --filter @ct/mobile start",
    "typecheck": "pnpm -r typecheck",
    "messages": "pnpm --filter @ct/web messages && pnpm --filter @ct/mobile messages",
    "literals": "node scripts/literals.cjs",
    "test": "pnpm --filter @ct/api test",
    "test:coverage": "pnpm --filter @ct/api test:coverage",
    "build": "pnpm -r build",
    "seed": "pnpm --filter @ct/api seed",
    "seed:library": "pnpm --filter @ct/api seed:library",
    "db:reset": "bash scripts/db-reset.sh",
    "cards:cast": "tsx scripts/content/cast-cards.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "sharp": "^0.34.5",
    "tsx": "^4.23.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@expo/metro-runtime": "57.0.14"
    },
    "patchedDependencies": {
      "react-native-reanimated@4.5.1": "patches/react-native-reanimated@4.5.1.patch"
    }
  }
}

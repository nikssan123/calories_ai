    "@ct/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "aws4fetch": "^1.0.20",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "franc": "^6.2.0",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ct/api-client": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.11",

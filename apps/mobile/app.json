{
  "expo": {
    "name": "Day So Far",
    "slug": "day-so-far",
    "scheme": "daysofar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fff6ec",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daysofar.app",
      "associatedDomains": [
        "applinks:daysofar.com"
      ]
    },
    "android": {
      "package": "com.daysofar.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "daysofar.com",
              "pathPrefix": "/progress"
            },
            {
              "scheme": "https",
              "host": "daysofar.com",
              "pathPrefix": "/today"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#fff6ec"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff6ec",
          "dark": {
            "backgroundColor": "#1a1512"
          },
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Day So Far uses the camera to read a barcode or photograph a meal. Photos of your food are sent to be identified; a barcode is read on the phone."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Day So Far uses the microphone so you can say what you ate instead of typing it.",
          "speechRecognitionPermission": "Day So Far turns what you say into the sentence it logs. Your phone does the listening.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Day So Far opens your photos so you can log a meal you already photographed.",
          "cameraPermission": "Day So Far uses the camera to photograph a meal so it can be identified and logged."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "iosShareExtensionName": "Log with Day So Far",
          "androidIntentFilters": [
            "image/*"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Baloo2_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "Ring",
              "label": "Day So Far · ring",
              "description": "Today's ring. Drag it down to the size of an icon, or up to fill the row.",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Day",
              "label": "Day So Far · day",
              "description": "The day on one line, with a bar. Drag it taller for the ring.",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-widget-font",
      "./plugins/with-androidx-work",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.daysofar.app.widgets",
          "groupIdentifier": "group.com.daysofar.app",
          "widgets": [
            {
              "name": "Ring",
              "displayName": "Ring",
              "description": "Today's ring, at the size of an app icon.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "Day",
              "displayName": "Day",
              "description": "The ring, what it is out of, and what you have burned.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25475a2b-9d0f-478d-8a4f-dadffb0a37b8"
      }
    }
  }
}

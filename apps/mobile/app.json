{
  "expo": {
    "name": "Day So Far",
    "slug": "day-so-far",
    "scheme": "daysofar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#fff6ec",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daysofar.app"
    },
    "android": {
      "package": "com.daysofar.app",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#fff6ec"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff6ec",
          "dark": {
            "backgroundColor": "#1a1512"
          },
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Day So Far uses the camera to read a barcode or photograph a meal. Photos of your food are sent to be identified; a barcode is read on the phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Day So Far opens your photos so you can log a meal you already photographed.",
          "cameraPermission": "Day So Far uses the camera to photograph a meal so it can be identified and logged."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "iosShareExtensionName": "Log with Day So Far",
          "androidIntentFilters": [
            "image/*"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Day",
              "label": "Day So Far",
              "description": "Today's ring, and a tap into the journal.",
              "minWidth": "150dp",
              "minHeight": "150dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25475a2b-9d0f-478d-8a4f-dadffb0a37b8"
      }
    }
  }
}

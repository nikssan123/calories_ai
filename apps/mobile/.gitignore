dist/
# Anchored. Unanchored these match a directory called `ios` or `android` at any
# depth, which silently swallowed `widget/ios/` — the iOS widget's source, not
# a prebuild artefact. Only the two at the package root are generated.
/ios/
/android/
*.log

# What `eas build --local` drops beside the project when it succeeds. Tens of
# megabytes of signed binary, one per build, and nothing about it belongs in a
# repository — but it lands untracked rather than ignored, so `git add -A` is
# one keystroke away from committing an 88MB .aab.
/build-*.aab
/build-*.apk
/build-*.ipa
/build-*.tar.gz


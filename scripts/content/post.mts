}
type Post = Base &
  (
    | { template: 'statement'; kicker: string; headline: string }
    | { template: 'typed-day'; day: string; entries: { t: string; m: string }[]; foot: string }
    | { template: 'macro-bar'; headline: string; rows: { k: string; p: number; c: number; f: number }[] }
    | { template: 'glyph'; head: string; tail: string; name: CastName; mood: Mood }
    | { template: 'pair'; headline: string; cells: { name: CastName; mood: Mood; prop?: Prop; val: string; lbl: string }[] }
    | { template: 'carousel'; num: string; headline: string; name: CastName; mood: Mood }
    | { template: 'crop'; headline: string; name: CastName; mood: Mood; prop?: Prop }
    | { template: 'split'; headline: string; name: CastName; mood: Mood; prop?: Prop }
    | { template: 'staged'; headline: string; sub: string; name: CastName; mood: Mood }
  )

// One post per template. Every line is an idea about eating that stands on its
// own: none names a feature, shows a screen, or puts a number on an image.

/* ── slideshows ─────────────────────────────────────────────────────── */

/**
 * The nine templates above each make one post. A slideshow is the other shape:
 * one idea split across four or five slides that are read by swiping, and the
 * format that carries furthest right now on both TikTok and Reels.
 *
 * Three beats per slide, in this order, because that is the arrangement the
 * high-performing ones use and it is doing real work:
 *
 *   aside    a parenthetical, small. Reassurance or an aside — it lowers the
 *            stakes before the claim lands.
 *   claim    numbered, largest, the thing being said. On slide 0 this is the
 *            hook and there is nothing else.
 *   reason   one sentence on why it is true. Not a second claim.
 *
 * Set in white pills on a photograph rather than white type over it: it is what
 * a native caption looks like on both platforms, and it survives a bright
 * ground, which white type does not. `box-decoration-break:clone` is what gives
 * every wrapped line its own pill instead of one box behind the block.
 *
 * The grounds come from content/stock/ — real photographs, pulled by
 * scripts/content/stock.mts. Per §0 nothing here may put a number on one, which
 * is why a slide's beats carry sentences and never a figure.
 */
interface Slideshow {
  key: string
  /** A set under content/stock/ whose photographs ground the slides. */
  stock: string
  /** Slide 0, alone on the cover. Taken from content/hooks/hooks.txt. */
  hook: string
  beats: { aside?: string; claim: string; reason?: string }[]
  /**
   * Explicit grounds, one per slide including the cover, when the photograph is
   * part of the point rather than a backdrop. The library formats generated by
   * `slides.mts` set this: a guess-the-calories slide has to show *that* dish,
   * and a random photograph of somebody else's lunch would make the number a
   * lie. Falls back to the `stock` set when absent.
   */
  grounds?: (string | undefined)[]
}


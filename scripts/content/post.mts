#!/usr/bin/env tsx
// Nine post templates, and one post built from each.
//
//   npx tsx scripts/content/post.mts                  # all nine, 1080x1350
//   npx tsx scripts/content/post.mts --only statement
//   npx tsx scripts/content/post.mts --size story
//
// A template is a layout; a POSTS entry is the copy poured into one. To ship a
// new post, add an entry — the layouts are meant to be reused, not rewritten.
// The nine were picked off a layout board so they fail differently from each
// other: three carry no character at all, three keep it subordinate to type or
// data, three let it lead. A feed of nine variations on one shape reads as one
// post; this is the spread that stops it.
//
// Where each layer comes from:
//
//   cast   packages/shared/src/cast.ts — the same geometry the phone, the
//          widget and the site draw, at any size, in any of eighteen moods.
//          Never redrawn by hand, never regenerated by a model.
//   type   apps/mobile/assets/fonts — Baloo2 for the shouting, Nunito for
//          reading, IBM Plex Mono for timestamps and labels. All three SIL OFL.
//   ground a CSS field by default. Pass `ground` on an entry to lay a
//          ComfyUI render from content/gen/ underneath instead (§10) — texture
//          only, never a subject, and never anything a number could sit on.
//
// Composition rules the layouts encode, learned by getting them wrong first:
// a lineup is not a composition; a mood needs its scene (`stir` draws the ladle
// and not the pot); one face at one weight is the amateur tell; and a figure
// without a halo and a real contact shadow floats on the ground like a sticker.
//
// Rasterised by headless Chrome: the only renderer here that reads both SVG and
// a webfont (sharp is not installed, ffmpeg does neither).

import { spawnSync } from 'node:child_process'
import { existsSync, mkdirSync, writeFileSync, statSync } from 'node:fs'
import { join, resolve } from 'node:path'
import { pathToFileURL } from 'node:url'
import { figureMarkup, GRID, type CastName, type Mood, type Prop } from '../../packages/shared/src/cast'

/* ── frame ──────────────────────────────────────────────────────────── */

const SIZES: Record<string, { w: number; h: number }> = {
  post: { w: 1080, h: 1350 },
  story: { w: 1080, h: 1920 },
  square: { w: 1080, h: 1080 },
}

const FLAGS = new Set(['size', 'out', 'only'])
const argv = process.argv.slice(2)
const opts: Record<string, string> = {}
for (let i = 0; i < argv.length; i++) {
  const a = argv[i]
  if (!a.startsWith('--')) continue
  const name = a.slice(2)
  if (!FLAGS.has(name)) {
    console.error(`Unknown flag --${name}. Known: ${[...FLAGS].join(', ')}`)
    process.exit(1)
  }
  opts[name] = argv[++i]
}

const SIZE = opts.size ?? 'post'
const OUTDIR = opts.out ?? 'content/out/posts'
if (!SIZES[SIZE]) {
  console.error(`Unknown --size ${SIZE}. Known: ${Object.keys(SIZES).join(', ')}`)
  process.exit(1)
}
const { w: W, h: H } = SIZES[SIZE]

/**
 * The composition is laid out in a stage, which is the frame everywhere except
 * story. A 9:16 story is mostly chrome — the top and bottom ~250px sit under
 * Instagram's own UI — so there the stage stays the 4:5 composition, centred,
 * while the ground fills the whole frame. That puts every element inside the
 * safe area by construction instead of by a table of insets, and it means one
 * set of coordinates renders all three sizes.
 */
const STAGE_H = SIZE === 'story' ? 1350 : H
const STAGE_TOP = Math.round((H - STAGE_H) / 2)

/**
 * A figure's box, as a share of the stage height but capped against the frame
 * width. Without the cap a tall frame grows the figure until it runs out of
 * the sides; without the height share a square frame keeps a figure sized for
 * a taller one and swallows the type.
 */
const figBox = (hFrac: number, wFrac: number) => Math.round(Math.min(STAGE_H * hFrac, W * wFrac))

const FONTS = {
  display: 'apps/mobile/assets/fonts/Baloo2_800ExtraBold.ttf',
  text400: 'apps/mobile/assets/fonts/Nunito_400.woff2',
  text600: 'apps/mobile/assets/fonts/Nunito_600.woff2',
  text700: 'apps/mobile/assets/fonts/Nunito_700.woff2',
  mono400: 'apps/mobile/assets/fonts/PlexMono_400.woff2',
  mono500: 'apps/mobile/assets/fonts/PlexMono_500.woff2',
}

// Sampled from store/feature-graphic.png, as scripts/content/cards.mjs does.
const INK = '#1b1a15'
const CREAM = '#f7efe6'
const JADE = '#0f9a5a'

/** Each figure's mid ramp stop, for the halo it stands in (cast.ts FIGURES). */
const HALO: Record<CastName, string> = { ember: '#ffa51f', skye: '#3b9eff', plum: '#b06bff' }

/* ── the posts ──────────────────────────────────────────────────────── */

interface Base {
  key: string
  /** Optional ComfyUI render from content/gen/ laid under the CSS field. */

# --- API ---
DATABASE_URL=postgres://ct:ct@localhost:5433/calorytracker
PORT=4000

# --- AI provider ---
# Which service runs the journal. `anthropic` (default), `anthropic-api` or
# `openai`. All three share the same tool handlers, so a meal is logged
# identically whichever one ran the turn.
AI_PROVIDER=anthropic

# The two Claude providers are the same models reached two different ways, and
# both are permanent — pick by where it runs, not by quality.

# anthropic: runs on your Claude Code subscription — the Agent SDK reads the
# OAuth credentials `claude` writes to ~/.claude/.credentials.json, so there is
# nothing to set here. Right for a personal install: no key, no per-token bill,
# and one person on one box is the shape the Agent SDK is good at. It spawns the
# `claude` binary once per turn, so a turn holds a process for its whole twenty
# seconds — which is why it is not what you want serving other people.

# anthropic-api: the same Claude models over the Messages API, on a metered key.
# No subprocess and no session file, which is what lets the API run more than one
# replica. This is what a deployment serving other people should run.
# ANTHROPIC_API_KEY=sk-ant-...   # https://console.anthropic.com/settings/keys
#
# Note that setting ANTHROPIC_API_KEY does NOT by itself switch providers — it is
# also what the Agent SDK picks up in preference to the subscription. Set
# AI_PROVIDER=anthropic-api to choose this one.

# openai: a metered API key. A ChatGPT subscription does NOT cover API usage —
# these are separate products. Create a key at
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
#
# Whatever model your account can see. Names churn, so this is yours to set.
# OPENAI_MODEL=gpt-4o
#
# Optional per-turn overrides, each falling back to OPENAI_MODEL. Worth setting
# when your vendor's line-up is uneven — logging is high volume and wants the
# cheap model, photos need one that can see, the weekly review runs once.
# OPENAI_MODEL_TEXT=
# OPENAI_MODEL_VISION=
# OPENAI_MODEL_SETUP=
# OPENAI_MODEL_REVIEW=
#
# Any OpenAI-compatible endpoint works — Groq, Together, OpenRouter, a local
# Ollama. Point this at its base URL and set OPENAI_API_KEY to that service's key.
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# What a token costs, in USD per million, so the admin panel's cost report can
# price this provider — the API returns tokens but never a price, and the right
# rate depends on which of the above you pointed it at. Leave them unset and the
# panel records tokens and reports the cost as unknown rather than as zero.
# OPENAI_PRICE_INPUT=2.50
# OPENAI_PRICE_OUTPUT=10.00

# Accounts are email + password with server-side sessions. Set false once your
# own account exists to stop anyone else registering (the very first account is
# always allowed, or the server would be unusable).
ALLOW_SIGNUP=true

# Set true when serving over HTTPS so session cookies carry the Secure flag.
SECURE_COOKIES=false

# --- Signing in with Google (optional) ---
# Off unless both of these are set, in which case the sign-in screen grows a
# "Continue with Google" button. Create an OAuth client ID of type "Web
# application" at https://console.cloud.google.com/apis/credentials and add the
# redirect URI below to it, byte for byte — Google matches it exactly.
#
# The scopes asked for are openid, email and profile. All three are
# non-sensitive, so the consent screen needs no review from Google.
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
#
# Where Google sends the browser back. Defaults to APP_URL + the path below,
# which is the web app rather than this API — and has to be: the callback sets
# the session cookie, and a cookie set on the API's own hostname is one the
# browser will never send to the app. Only set this if your deployment puts the
# web app somewhere APP_URL does not describe.
# GOOGLE_REDIRECT_URI=https://daysofar.com/api/auth/google/callback

# Browser origins allowed to call the API cross-origin with credentials, comma
# separated. Only needed once the API answers on its own hostname: a browser
# sends the session cookie with these requests, so reflecting whatever Origin
# arrives would let any site on the internet act as a signed-in user. The mobile
# apps are deliberately absent — they send no Origin and CORS does not apply.
# WEB_ORIGINS=https://daysofar.com

# Which peers may be believed when they set X-Forwarded-For. Unset means none,
# which is right with nothing in front. Behind a reverse proxy set it, or the
# rate limiter reads the proxy's address on every request and buckets every
# anonymous caller in the world together. Takes a CIDR or one of proxy-addr's
# named ranges; `uniquelocal` is right for a proxy on a private Docker network.
# Avoid `true`: it trusts the whole forwarded chain, letting a caller name its
# own address and so choose its own rate-limit bucket.
# TRUST_PROXY=uniquelocal

# Who can open /admin — a comma-separated list of emails. Leave it unset and the
# first account created holds the panel, which is what you want on a personal
# install. Setting it replaces that fallback entirely rather than adding to it.
# ADMIN_EMAILS=you@example.com

# Where uploaded meal photos are written.
UPLOAD_DIR=./uploads

# --- Email (Resend) ---
# Optional. With no key the server writes each message to its log instead of
# sending it — including reset links, which is exactly what you want locally.
# Nothing in the product is gated on an email arriving, so leaving this unset is
# a supported way to run a personal install.
#
# Create a key at https://resend.com/api-keys
# RESEND_API_KEY=re_...
#
# The From header. The default is Resend's shared sandbox sender, which works
# with a fresh account and no DNS but will only deliver to the address that owns
# the account. Set your own once you have verified a domain.
# EMAIL_FROM=Day So Far <notifications@yourdomain.com>
#
# Where replies go, if not to the From address. Worth setting: several of these
# messages end with "reply to this email", and a no-reply sender makes that a lie.
# EMAIL_REPLY_TO=support@yourdomain.com
#
# --- Receiving ---
# Signs the inbound webhook Resend posts to /email/inbound. Copy it from the
# webhook you create in the Resend dashboard. Unset means the endpoint refuses
# everything, which is the right default: it is public and writable, and the
# signature is the only thing authenticating the caller.
#
# Receiving also needs an MX record on the domain — see the README. Without one
# the "reply to this email" line in several of these messages is a lie.
# RESEND_WEBHOOK_SECRET=whsec_...
#
# Sends every message to this address instead of the real recipient, with the
# intended one in the subject. Makes the sandbox sender's one-address limit
# usable for testing the whole flow end to end.
# EMAIL_REDIRECT_TO=you@example.com

# --- Barcodes ---
# Open Food Facts needs neither a key nor an account and is what the scanner
# uses out of the box. Their policy asks callers to identify themselves as
# `AppName/Version (contact)` and throttles the generic agents that do not; the
# default is built from APP_URL below, which is usually enough.
# BARCODE_USER_AGENT=DaySoFar/1.0 (https://yourdomain.com)
#
# USDA FoodData Central, consulted only when Open Food Facts came back empty.
# Worth setting for American users and pointless without them: OFF covers the EU
# shelf well on its own, and this is what answers the branded US half. Free key,
# no card: https://fdc.nal.usda.gov/api-key-signup.html
# FDC_API_KEY=

# Where the browser reaches this deployment. Every link in an email is built
# from it, so it must be the address a person can actually open — not the API's
# own hostname behind the proxy.
APP_URL=http://localhost:3000

# --- Web (apps/web/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000
